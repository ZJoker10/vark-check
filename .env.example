# ---------------------------------------------------------------------------
# VARK Check — environment configuration
# Copy to .env and fill in:  cp .env.example .env
# ---------------------------------------------------------------------------

# Which LLM backend to use: deepseek | openai | ollama | mock
# "mock" is a deterministic offline stub used by the test suite. It is not
# useful for a live demo (it does not think).
LLM_PROVIDER=deepseek

# API key. For ollama this can be any non-empty string.
LLM_API_KEY=sk-your-key-here

# Override only if you use a non-default endpoint (or a proxy/gateway).
# Defaults are filled in automatically per provider:
#   deepseek -> https://api.deepseek.com/v1   (model: deepseek-chat)
#   openai   -> https://api.openai.com/v1     (model: gpt-4o-mini)
#   ollama   -> http://localhost:11434/v1     (model: llama3.1)
# LLM_BASE_URL=
# LLM_MODEL=

# Generation settings
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1200

# Agent loop limits (the "step budget" and the token budget from the brief)
AGENT_MAX_STEPS=6
AGENT_TOKEN_BUDGET=25000

# Retrieval
RAG_TOP_K=4
RAG_CHUNK_CHARS=1200

# Storage
DB_PATH=data/varkcheck.db
LOG_DIR=logs
